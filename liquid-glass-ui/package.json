{
  "name": "liquid-glass-ui-workspace",
  "private": true,
  "version": "0.2.0-alpha.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config apps/playground/vite.config.ts",
    "preview": "node scripts/serve-preview.mjs",
    "build": "npm run build:packages && vite build --config apps/playground/vite.config.ts",
    "build:packages": "tsc -b packages/tokens packages/core packages/react && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "npm run test:core",
    "test:core": "node --test tests/core/*.test.mjs",
    "test:e2e": "playwright test",
    "test:chrome": "playwright test --project=chrome",
    "test:ssr": "node --test tests/ssr.test.mjs",
    "test:csp": "playwright test tests/browser/csp.spec.ts --project=chrome",
    "check": "npm run typecheck && npm run build && npm test && npm run test:ssr && npm run test:chrome",
    "check:syntax": "node scripts/check-syntax.mjs",
    "size": "node scripts/size-report.mjs",
    "registry:build": "node scripts/build-registry.mjs",
    "manifest:build": "node scripts/build-delivery-manifest.mjs",
    "source:copy": "node scripts/copy-source.mjs",
    "pack:local": "node scripts/pack-local.mjs",
    "preview:built": "node scripts/serve-preview.mjs --root apps/playground/dist",
    "test:all": "npm test && npm run test:ssr && npm run test:chrome",
    "preview:rebuild": "node scripts/rebuild-preview.mjs",
    "test:preview-server": "node scripts/test-preview-server.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "~5.8.3",
    "vite": "^7.1.12"
  },
  "license": "MIT"
}
